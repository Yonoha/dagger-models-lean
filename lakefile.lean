/-- Build an explicit dependency order with one loaded workspace and one Lean job at a time. -/
script buildSequential (args) do
  let [orderFile] := args | throw <| IO.userError "Expected a module-order file"
  let workspace ← getWorkspace
  let contents ← IO.FS.readFile orderFile
  let modules := contents.splitOn "\n" |>.filter (· != "")
  workspace.runFetchM do
    for (name, index) in modules.zipIdx do
      let some mod := workspace.findModule? name.toName
        | error s!"Unknown registered module: {name}"
      IO.println s!"START_SOURCE {index + 1} {modules.length} {name}"
      let job ← mod.leanArts.fetch
      let _ ← job.await
      IO.println s!"BUILT_SOURCE {index + 1} {modules.length} {name}"
      (← IO.getStdout).flush
  return 0
