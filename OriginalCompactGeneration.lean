import Mathlib.Topology.Compactness.CompactlyGeneratedSpace
import TopCatModelCategory.Convenient.Fibrations

/-!
# Native compact generation as generation by compact Hausdorff probes

The family consists of all compact Hausdorff spaces in the original universe.
Its generated topology is proved equal to Mathlib's compactly generated
topology. Standard singular simplices are generated by this family in every
universe, using the native ULift homeomorphism.
-/

set_option autoImplicit false

open CategoryTheory CategoryTheory.Limits Topology

universe u

namespace DaggerOriginalCompactGeneration

/-- All compact Hausdorff probe spaces in the original universe. -/
abbrev compactHausFamily (K : CompHaus.{u}) : Type u := K

/-- Native probe generation is exactly Mathlib's compact generation topology. -/
theorem generatedTopology_eq_compactlyGenerated (Y : Type u) [TopologicalSpace Y] :
    TopologicalSpace.generatedBy compactHausFamily.{u} (Y := Y) =
      TopologicalSpace.compactlyGenerated.{u} Y := by
  ext U
  simp [TopologicalSpace.generatedBy, TopologicalSpace.compactlyGenerated,
    isOpen_iSup_iff, isOpen_coinduced, compactHausFamily]
  constructor
  · intro h ⟨K, f⟩
    exact h K f
  · intro h K f
    exact h ⟨K, f⟩

/-- Any actual compact Hausdorff space in the original universe is one of the probes. -/
instance compactHaus_generated (Y : Type u) [TopologicalSpace Y]
    [CompactSpace Y] [T2Space Y] : IsGeneratedBy compactHausFamily.{u} Y :=
  inferInstanceAs (IsGeneratedBy compactHausFamily.{u} (compactHausFamily (CompHaus.of Y)))

/-- Standard singular simplex domains are compact-generated by probes of any ambient universe. -/
instance singularSimplex_generated (n : SimplexCategory) :
    IsGeneratedBy compactHausFamily.{u} (_root_.stdSimplex ℝ (Fin (n.len + 1))) :=
  (Homeomorph.ulift.{u}).isQuotientMap.isGeneratedBy

/-- The standard realized simplex domain is generated by original-universe probes. -/
instance realizedSimplex_generated (n : SimplexCategory) :
    IsGeneratedBy compactHausFamily.{u} (SSet.toTop.{u}.obj (SSet.stdSimplex.obj n)) := by
  have : CompactSpace (SimplexCategory.toTop.{u}.obj n) :=
    inferInstanceAs (CompactSpace (ULift (_root_.stdSimplex ℝ (Fin (n.len + 1)))))
  have : T2Space (SimplexCategory.toTop.{u}.obj n) :=
    inferInstanceAs (T2Space (ULift (_root_.stdSimplex ℝ (Fin (n.len + 1)))))
  exact (TopCat.homeoOfIso (SSet.toTopSimplex.{u}.app n)).symm.isQuotientMap.isGeneratedBy

/-- Every original simplicial realization has the compact-generated probe topology. -/
instance realization_generated (T : SSet.{u}) :
    IsGeneratedBy compactHausFamily.{u} (SSet.toTop.obj T) :=
  isGeneratedBy.of_isColimit (isColimitOfPreserves SSet.toTop T.isColimitCoconeFromElementsOp)
    (fun _ ↦ by dsimp; infer_instance)

end DaggerOriginalCompactGeneration
