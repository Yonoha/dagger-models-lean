import NativeFreePathSpineWeak

/-! The weighted spine is precisely the complex generated by all vertices and original edges. -/
set_option autoImplicit false
open CategoryTheory Simplicial HomotopicalAlgebra
open scoped SSet.modelCategoryQuillen
open DaggerNativeFreePathNerveWeight DaggerNativeFreePathNerveWeightOperators
open DaggerNativeFreePathInnerFaceNondegeneracy DaggerNativeFreePathSubdivisionInverse
universe u
namespace DaggerNativeFreePathGeneratorComplex
noncomputable section

variable (V : Type u) [Quiver.{u + 1} V]

def generatorComplex : (nerve (Paths V)).Subcomplex :=
  (⨆ x : V, SSet.Subcomplex.ofSimplex (ComposableArrows.mk₀ (show Paths V from x))) ⊔
    ⨆ (x : V) (y : V) (e : x ⟶ y),
      SSet.Subcomplex.ofSimplex (ComposableArrows.mk₁ e.toPath)

variable {V}

theorem dimension_le_weight {n : ℕ} (c : ComposableArrows (Paths V) n)
    (hc : c ∈ (nerve (Paths V)).nonDegenerate n) : n ≤ weight c := by
  induction n with
  | zero => exact Nat.zero_le _
  | succ n ih =>
    have hf := (nonDegenerate_iff_front c).mp hc
    have ht := ih c.δ₀ hf.2
    have hw := weight_delta_zero c
    change weight c = (c.map' 0 1).length + weight c.δ₀ at hw
    omega

theorem generatorComplex_le_spine : generatorComplex V ≤ generatorSpine V := by
  apply sup_le
  · apply iSup_le
    intro x
    rw [SSet.Subcomplex.ofSimplex_le_iff]
    change weight (ComposableArrows.mk₀ (show Paths V from x)) ≤ 1
    rw [weight_vertex]
    decide
  · apply iSup_le
    intro x
    apply iSup_le
    intro y
    apply iSup_le
    intro e
    rw [SSet.Subcomplex.ofSimplex_le_iff]
    change weight (ComposableArrows.mk₁ e.toPath) ≤ 1
    rw [weight_edge]

theorem vertex_mem_generatorComplex (x : V) :
    ComposableArrows.mk₀ (show Paths V from x) ∈ (generatorComplex V).obj _ := by
  have h : SSet.Subcomplex.ofSimplex (ComposableArrows.mk₀ (show Paths V from x)) ≤
      generatorComplex V := le_sup_of_le_left (le_iSup (fun y : V ↦
        SSet.Subcomplex.ofSimplex (X := nerve (Paths V))
          (ComposableArrows.mk₀ (show Paths V from y))) x)
  exact h _ (SSet.Subcomplex.mem_ofSimplex_obj _)

theorem edge_mem_generatorComplex {x y : V} (e : x ⟶ y) :
    ComposableArrows.mk₁ e.toPath ∈ (generatorComplex V).obj _ := by
  have h : SSet.Subcomplex.ofSimplex (ComposableArrows.mk₁ e.toPath) ≤
      generatorComplex V := le_sup_of_le_right (le_iSup_of_le x
        (le_iSup_of_le y (le_iSup (fun f : x ⟶ y ↦
          SSet.Subcomplex.ofSimplex (X := nerve (Paths V)) (ComposableArrows.mk₁ f.toPath)) e)))
  exact h _ (SSet.Subcomplex.mem_ofSimplex_obj _)

theorem spine_le_generatorComplex : generatorSpine V ≤ generatorComplex V := by
  rw [SSet.Subcomplex.le_iff_contains_nonDegenerate]
  rintro n ⟨c, hc⟩ hw
  change c ∈ (generatorComplex V).obj _
  have hd := dimension_le_weight c hc
  change n ≤ weight c at hd
  change weight c ≤ 1 at hw
  cases n with
  | zero =>
    obtain ⟨x, rfl⟩ := ComposableArrows.mk₀_surjective c
    exact vertex_mem_generatorComplex (show V from x)
  | succ n =>
    cases n with
    | zero =>
      change ComposableArrows (Paths V) 1 at c
      have hp : 0 < c.hom.length := ((nonDegenerate_iff_front c).mp hc).1
      have he : c.hom.length = 1 := by
        change c.hom.length ≤ 1 at hw
        omega
      obtain ⟨e, he⟩ := path_eq_generator_of_length_one (V := V) c.hom he
      rw [← ComposableArrows.mk₁_hom c, ← he]
      exact edge_mem_generatorComplex e
    | succ n => omega

theorem generatorComplex_eq_spine : generatorComplex V = generatorSpine V :=
  le_antisymm generatorComplex_le_spine spine_le_generatorComplex

theorem generatorComplex_weak : WeakEquivalence (generatorComplex V).ι := by
  rw [generatorComplex_eq_spine]
  exact DaggerNativeFreePathSpineWeak.generatorSpine_weak V

end
end DaggerNativeFreePathGeneratorComplex
