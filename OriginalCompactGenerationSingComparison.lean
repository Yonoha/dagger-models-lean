import OriginalCompactGeneration

/-!
# Singular invariance under the original compact generation

The native compact-Hausdorff probe coreflection has exactly Mathlib's compactly
generated topology. Its literal counit induces a natural singular isomorphism.
Native TopCat weak-equivalence and fibration assertions are also preserved and
reflected, by this same singular comparison.
-/

set_option autoImplicit false

open CategoryTheory CategoryTheory.Limits Topology HomotopicalAlgebra
open scoped TopCat.modelCategory
open DaggerOriginalCompactGeneration

universe u

namespace DaggerOriginalCompactGenerationSingComparison

noncomputable section

/-- The native full subcategory generated by original-universe compact Hausdorff probes. -/
abbrev CompactGeneratedTopCat : Type (u + 1) :=
  GeneratedByTopCat.{u} compactHausFamily.{u}

/-- The literal inclusion of native compact-generated spaces into TopCat. -/
abbrev compactGeneratedToTop : CompactGeneratedTopCat.{u} ⥤ TopCat.{u} :=
  GeneratedByTopCat.toTopCat

/-- The native compact generation functor with original-universe compact Hausdorff probes. -/
abbrev compactGenerationFunctor : TopCat.{u} ⥤ CompactGeneratedTopCat.{u} :=
  TopCat.toGeneratedByTopCat

/-- The actual native compact generation coreflection adjunction. -/
def compactGenerationAdjunction : compactGeneratedToTop.{u} ⊣ compactGenerationFunctor :=
  GeneratedByTopCat.adj

/-- Compact generation followed by the literal topological inclusion. -/
abbrev compactGenerationTopFunctor : TopCat.{u} ⥤ TopCat.{u} :=
  compactGenerationFunctor ⋙ compactGeneratedToTop

/-- The comparison to the original space is the native coreflection counit. -/
abbrev compactGenerationCounit : compactGenerationTopFunctor.{u} ⟶ 𝟭 TopCat :=
  compactGenerationAdjunction.counit

/-- The native compact generation object is compactly generated in Mathlib's precise sense. -/
instance compactGeneration_isCompactlyGenerated (Y : TopCat.{u}) :
    CompactlyGeneratedSpace (compactGenerationTopFunctor.obj Y) where
  le_compactlyGenerated := by
    have : IsGeneratedBy compactHausFamily.{u} (compactGenerationTopFunctor.obj Y) :=
      (compactGenerationFunctor.obj Y).property
    rw [← generatedTopology_eq_compactlyGenerated]
    exact IsGeneratedBy.le_generatedBy

/-- Every original realization is compactly generated in Mathlib's precise sense. -/
instance realization_isCompactlyGenerated (T : SSet.{u}) :
    CompactlyGeneratedSpace (SSet.toTop.obj T) where
  le_compactlyGenerated := by
    rw [← generatedTopology_eq_compactlyGenerated]
    exact IsGeneratedBy.le_generatedBy

/-- Compact generation does not change any singular simplex of the original space. -/
theorem singularCounit_bijective (Y : TopCat.{u}) (n : SimplexCategoryᵒᵖ) :
    Function.Bijective ((TopCat.toSSet.map (compactGenerationCounit.app Y)).app n) := by
  let e : (TopCat.toSSet.obj (compactGenerationTopFunctor.obj Y)).obj n ≃
      (TopCat.toSSet.obj Y).obj n :=
    (TopCat.toSSetObjEquiv _ _).trans (Equiv.trans
      (WithGeneratedByTopology.continuousMapEquiv (Z := Y)) (TopCat.toSSetObjEquiv _ _).symm)
  exact e.bijective

/-- The native singular counit component is an isomorphism on every singular simplex. -/
instance singularCounit_app_isIso (Y : TopCat.{u}) (n : SimplexCategoryᵒᵖ) :
    IsIso ((TopCat.toSSet.map (compactGenerationCounit.app Y)).app n) := by
  rw [isIso_iff_bijective]
  exact singularCounit_bijective Y n

/-- The native singular counit is an isomorphism of the actual simplicial sets. -/
instance singularCounit_isIso (Y : TopCat.{u}) :
    IsIso (TopCat.toSSet.map (compactGenerationCounit.app Y)) := by
  rw [NatTrans.isIso_iff_isIso_app]
  intro n
  infer_instance

/-- The compact generation counit is a natural isomorphism after singular. -/
instance singularCounit_whisker_isIso :
    IsIso (Functor.whiskerRight compactGenerationCounit.{u} TopCat.toSSet) := by
  rw [NatTrans.isIso_iff_isIso_app]
  intro Y
  dsimp
  infer_instance

/-- Singular of compact generation is naturally isomorphic to the original singular functor. -/
def compactGenerationSingIso :
    compactGenerationTopFunctor.{u} ⋙ TopCat.toSSet ≅ TopCat.toSSet :=
  asIso (Functor.whiskerRight compactGenerationCounit TopCat.toSSet) ≪≫
    Functor.leftUnitor TopCat.toSSet

/-- The comparison preserves the literal singular image of every original topological arrow. -/
def compactGenerationSingArrowIso {X Y : TopCat.{u}} (f : X ⟶ Y) :
    Arrow.mk (TopCat.toSSet.map (compactGenerationTopFunctor.map f)) ≅
      Arrow.mk (TopCat.toSSet.map f) :=
  ((Functor.mapArrowFunctor _ _).mapIso
    (asIso (Functor.whiskerRight compactGenerationCounit TopCat.toSSet))).app (Arrow.mk f)

/-- Native fibration assertions are preserved and reflected by actual compact generation. -/
theorem compactGeneration_fibration_iff {X Y : TopCat.{u}} (f : X ⟶ Y) :
    Fibration (compactGenerationTopFunctor.map f) ↔ Fibration f := by
  rw [← TopCat.modelCategory.fibration_toSSet_map_iff,
    ← TopCat.modelCategory.fibration_toSSet_map_iff, fibration_iff, fibration_iff]
  exact MorphismProperty.arrow_mk_iso_iff _ (compactGenerationSingArrowIso f)

/-- Native weak-equivalence assertions are preserved and reflected by actual compact generation. -/
theorem compactGeneration_weakEquivalence_iff {X Y : TopCat.{u}} (f : X ⟶ Y) :
    WeakEquivalence (compactGenerationTopFunctor.map f) ↔ WeakEquivalence f := by
  simp only [TopCat.modelCategory.weakEquivalence_iff]
  exact MorphismProperty.arrow_mk_iso_iff _ (compactGenerationSingArrowIso f)

end

end DaggerOriginalCompactGenerationSingComparison
