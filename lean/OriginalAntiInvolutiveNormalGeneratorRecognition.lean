import OriginalAntiInvolutiveRelativeCellPushout
import OriginalAntiInvolutiveNormalMonoSaturation
import Mathlib.CategoryTheory.MorphismProperty.TransfiniteComposition
import TopCatModelCategory.MorphismProperty
import Mathlib.Combinatorics.Quiver.ReflQuiver

/-!
# Actual relative free-boundary generation of all normal monomorphisms

The original all-degree `NormalMono` predicate is generated by the literal
`freeAnti.map (SSet.boundary n).ι` maps. The reverse inclusion uses the genuine
relative skeletal filtration, its orbit-indexed pushout stages, and the
explicit two-copy comparison with the original free left Kan extension.
No fixed-vertex or positive-degree substitute enters this statement.
-/

set_option autoImplicit false

open CategoryTheory Limits Simplicial Opposite

universe u

namespace DaggerModels.OriginalAntiInvolutiveNormalGeneratorRecognition

open DaggerModels.AntiInvolutiveSSet
open DaggerModels.OriginalTaggedReverseFreeCompletion
open DaggerModels.OriginalAntiInvolutiveFreePair
open DaggerModels.OriginalAntiInvolutiveNormalMonoClosure
open DaggerModels.OriginalAntiInvolutiveNormalMonoSaturation
open DaggerModels.OriginalAntiInvolutiveNormalGenerators
open DaggerModels.OriginalAntiInvolutiveRelativeSkeleton
open DaggerModels.OriginalAntiInvolutiveRelativeCellAttachment
open DaggerModels.OriginalAntiInvolutiveRelativeCellPushout
open DaggerModels.SSetBoundaryCells

noncomputable section

variable {X Y : AntiInvolutiveSSet.{u}} (f : X ⟶ Y)

/-- The left Kan free completion preserves the actual disjoint-union
coproduct of orbit-indexed ordinary boundaries. -/
def freeCopiesCofan (R : Type u) (K : SSet.{u}) :
    Cofan (fun _ : R ↦ freeAnti.obj K) :=
  Cofan.mk (freeAnti.obj (copies R K))
    (fun r ↦ freeAnti.map (copiesInclusion R K r))

/-- The literal free completion of the pointwise copies is their coproduct. -/
def freeCopiesIsColimit (R : Type u) (K : SSet.{u}) :
    IsColimit (freeCopiesCofan R K) := by
  letI : PreservesColimits freeAnti.{u} :=
    Adjunction.leftAdjoint_preservesColimits freeAntiAdjunction
  exact isColimitCofanMkObjOfIsColimit freeAnti
    (fun _ : R ↦ K) (copiesInclusion R K) (copiesIsColimit R K)

/-- The free completion of the ordinary copiesMap is a coproduct of the
literal original free-boundary generators, one per actual reversal orbit. -/
theorem freeCopiesBoundary_mem_coproducts (R : Type u) (n : ℕ) :
    (MorphismProperty.coproducts.{u} normalGeneratingCofibrations.{u})
      (freeAnti.map (copiesMap R (SSet.boundary.{u} n).ι)) := by
  let K : SSet.{u} := (SSet.boundary n).toSSet
  let L : SSet.{u} := (Δ[n] : SSet.{u})
  let q : K ⟶ L := (SSet.boundary n).ι
  let F₁ : Discrete R ⥤ AntiInvolutiveSSet.{u} :=
    Discrete.functor (fun _ : R ↦ freeAnti.obj K)
  let F₂ : Discrete R ⥤ AntiInvolutiveSSet.{u} :=
    Discrete.functor (fun _ : R ↦ freeAnti.obj L)
  let t : F₁ ⟶ F₂ := Discrete.natTrans (fun _ : Discrete R ↦ freeBoundary n)
  have h₁ : IsColimit (freeCopiesCofan R K) := freeCopiesIsColimit R K
  have h₂ : IsColimit (freeCopiesCofan R L) := freeCopiesIsColimit R L
  have hcomp (r : R) :
      copiesInclusion R K r ≫ copiesMap R q =
        q ≫ copiesInclusion R L r := by
    ext k a
    rfl
  have hφ : ∀ j,
      (freeCopiesCofan R K).ι.app j ≫ freeAnti.map (copiesMap R q) =
        t.app j ≫ (freeCopiesCofan R L).ι.app j := by
    intro j
    cases j with
    | mk r =>
      change freeAnti.map (copiesInclusion R K r) ≫
          freeAnti.map (copiesMap R q) =
        freeAnti.map q ≫ freeAnti.map (copiesInclusion R L r)
      calc
        _ = freeAnti.map (copiesInclusion R K r ≫ copiesMap R q) :=
          (freeAnti.map_comp _ _).symm
        _ = freeAnti.map (q ≫ copiesInclusion R L r) :=
          congrArg _ (hcomp r)
        _ = _ := freeAnti.map_comp _ _
  have hcol : normalGeneratingCofibrations.{u}.colimitsOfShape (Discrete R)
      (freeAnti.map (copiesMap R q)) := by
    refine MorphismProperty.colimitsOfShape.mk' F₁ F₂
      (freeCopiesCofan R K) (freeCopiesCofan R L) h₁ h₂ t ?_ _ hφ
    intro j
    exact ⟨n⟩
  exact (normalGeneratingCofibrations.{u}.colimitsOfShape_le_coproducts R)
    _ hcol

/-- The concrete orbit-indexed map is a coproduct of literal `freeAnti`
boundary generators, using uniqueness of the left adjoint, not a replacement
generating set. -/
theorem boundarySumMap_mem_coproducts (hf : NormalMono f) (n : ℕ) :
    letI : Mono f := (mono_iff_mono_hom f).2 hf.1
    (MorphismProperty.coproducts.{u} normalGeneratingCofibrations.{u})
      (boundarySumMap f n) := by
  letI : Mono f := (mono_iff_mono_hom f).2 hf.1
  let R := NewCellOrbit f n
  let K : SSet.{u} := (SSet.boundary n).toSSet
  let L : SSet.{u} := (Δ[n] : SSet.{u})
  let W : MorphismProperty AntiInvolutiveSSet.{u} :=
    (MorphismProperty.coproducts.{u} normalGeneratingCofibrations.{u})
  have hfree : W (freeAnti.map (copiesMap R (SSet.boundary n).ι)) :=
    freeCopiesBoundary_mem_coproducts R n
  have hcomp : W ((pairIsoFreeAnti.app (copies R K)).hom ≫
      freeAnti.map (copiesMap R (SSet.boundary n).ι)) :=
    MorphismProperty.RespectsIso.precomp W _ _ hfree
  have hnat : boundarySumMap f n ≫ (pairIsoFreeAnti.app (copies R L)).hom =
      (pairIsoFreeAnti.app (copies R K)).hom ≫
        freeAnti.map (copiesMap R (SSet.boundary n).ι) :=
    pairIsoFreeAnti.hom.naturality (copiesMap R (SSet.boundary n).ι)
  rw [← hnat] at hcomp
  exact (W.cancel_right_of_respectsIso
    (boundarySumMap f n) (pairIsoFreeAnti.app (copies R L)).hom).1 hcomp

/-- Every actual normal monomorphism is a countable relative composition of
pushouts of coproducts of the literal free boundary generators. -/
theorem normalMono_mem_transfinite_pushouts (hf : NormalMono f) :
    MorphismProperty.transfiniteCompositionsOfShape
      ((MorphismProperty.coproducts.{u} normalGeneratingCofibrations.{u}).pushouts)
      ℕ f := by
  letI : Mono f := (mono_iff_mono_hom f).2 hf.1
  let W : MorphismProperty AntiInvolutiveSSet.{u} :=
    ((MorphismProperty.coproducts.{u} normalGeneratingCofibrations.{u})).pushouts
  let t : TransfiniteCompositionOfShape ℕ f :=
    relativeSkeletonTransfiniteComposition f
  refine ⟨{
    toTransfiniteCompositionOfShape := t
    map_mem := ?_ }⟩
  intro n hn
  change W ((relativeSkeleton f).map (homOfLE (Nat.le_succ n)))
  exact ((MorphismProperty.coproducts.{u} normalGeneratingCofibrations.{u})).pushouts_mk
    (attachment_isPushout f hf n) (boundarySumMap_mem_coproducts f hf n)

/-- Reverse inclusion of the full saturation in the unchanged all-degree
normality predicate. -/
theorem normalMonos_le_normalGeneratorSaturation :
    normalMonos.{u} ≤
      (MorphismProperty.transfiniteCompositions.{u}
        (MorphismProperty.coproducts.{u} normalGeneratingCofibrations.{u}).pushouts).retracts := by
  intro X Y f hf
  apply MorphismProperty.le_retracts
  let W : MorphismProperty AntiInvolutiveSSet.{u} :=
    (MorphismProperty.coproducts.{u} normalGeneratingCofibrations.{u}).pushouts
  have hℕ : W.transfiniteCompositionsOfShape ℕ f :=
    normalMono_mem_transfinite_pushouts f hf
  have hShrink : W.transfiniteCompositionsOfShape (Shrink.{u} ℕ) f :=
    ((Classical.choice hℕ).ofOrderIso
      (orderIsoShrink.{u} ℕ).symm).mem
  exact (W.transfiniteCompositionsOfShape_le_transfiniteCompositions
    (Shrink.{u} ℕ)) _ hShrink

/-- Recognition of exactly the original anti-involutive normal monomorphisms
by the literal all-degree free boundary generators. -/
theorem normalMonos_eq_normalGeneratorSaturation :
    normalMonos.{u} =
      (MorphismProperty.transfiniteCompositions.{u}
        (MorphismProperty.coproducts.{u} normalGeneratingCofibrations.{u}).pushouts).retracts :=
  le_antisymm normalMonos_le_normalGeneratorSaturation
    normalGeneratorSaturation_le_normalMonos

end

end DaggerModels.OriginalAntiInvolutiveNormalGeneratorRecognition
