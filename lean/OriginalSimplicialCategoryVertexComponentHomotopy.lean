import OriginalSimplicialCategoryVertexEdgeHomotopy

/-!
# Component equality controls whole original Hom transport after realization

The original component quotient is generated by original edges. Native
realization and singular send each original edge homotopy to a homotopy with
Kan target; native reversal and transitivity handle the exact quotient closure.
No Kan hypothesis on the original Hom objects is required.
-/
set_option autoImplicit false
open CategoryTheory MonoidalCategory Opposite Simplicial DaggerModels
open DaggerOriginalSimplicialCategoryVertexComposition
open DaggerOriginalSimplicialCategoryVertexEdgeHomotopy
universe u
namespace DaggerOriginalSimplicialCategoryVertexComponentHomotopy
noncomputable section

/-- Equal original vertex components give homotopic entire Hom transports after realization. -/
theorem precomposeVertex_componentHomotopy (C : SimplicialCat.{u, u}) {x y : C.Obj}
    (a b : (C.enriched.Hom x y).obj (op ⦋0⦌))
    (h : SSet.π₀.mk a = SSet.π₀.mk b) (z : C.Obj) :
    Nonempty (SSet.Homotopy (DaggerNerveHomotopy.R.map (precomposeVertex C a z))
      (DaggerNerveHomotopy.R.map (precomposeVertex C b z))) := by
  have he : Relation.EqvGen (@SSet.π₀Rel (C.enriched.Hom x y)) a b := Quot.eq.mp h
  clear h
  induction he with
  | rel a b h =>
      obtain ⟨e, h₀, h₁⟩ := h
      exact ⟨(precomposeVertexEdgeHomotopy C ⟨e, h₀, h₁⟩ z).toTop.toSSet⟩
  | refl a =>
      exact ⟨SSet.Subcomplex.RelativeMorphism.Homotopy.ofEq rfl⟩
  | symm a b _ ih =>
      obtain ⟨h⟩ := ih
      exact ⟨SSet.Subcomplex.RelativeMorphism.Homotopy.symm h⟩
  | trans a b c _ _ ih₁ ih₂ =>
      obtain ⟨h₁⟩ := ih₁
      obtain ⟨h₂⟩ := ih₂
      exact ⟨SSet.Homotopy.trans h₁ h₂⟩

end
end DaggerOriginalSimplicialCategoryVertexComponentHomotopy
